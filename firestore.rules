rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 각 사용자는 users/{userId} 경로 및 그 하위 문서에 대해
    // 본인의 UID와 일치할 때만 읽기 및 쓰기 가능 (데이터 격리 및 보안 보장)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 단어장 서브컬렉션
      match /words/{wordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 기타 하위 컬렉션 (필요 시 확장 가능)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
